{
  "manifest_version": 3,
  "name": "Custom CSS",
  "version": "0.1",
  "description": "Custom CSS",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.monogame.net/*"
      ],
      "css": [
        "./Monogame-css/styles.css"
      ]
    }
  ]
}
